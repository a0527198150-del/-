# GEMINI_API_KEY: Placeholder kept so the Secrets Gradle plugin has a default file.
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# NOTE: The YouTube Data API key is no longer a build-time secret.
# The app asks for it on first launch and stores it on the device
# (see data/settings/SettingsRepository.kt). It can be replaced any time
# from the supervisor panel, without rebuilding the app.
